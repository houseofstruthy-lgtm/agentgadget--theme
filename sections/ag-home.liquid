<link rel='preconnect' href='https://fonts.googleapis.com'><link rel='preconnect' href='https://fonts.gstatic.com' crossorigin><link href='https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Michroma&display=optional' rel='stylesheet'><style>.shopify-section-group-header-group,.shopify-section-group-footer-group{display:none!important}body.gradient{background:#04060c!important}.ag{--ink:#04060c;--panel:#0d1730;--line:#1b2a4d;--blue:#1d5ff0;--blue-hi:#4da3ff;--silver:#d5dbe6;--dim:#96a1b6;--pa:#f1f3f7;--pb:#c9d0dc;--display:Michroma,Eurostile,'Arial Black',sans-serif;--body:Figtree,'Helvetica Neue',Arial,sans-serif;background:var(--ink);color:var(--silver);font-family:var(--body);font-size:17px;line-height:1.6;letter-spacing:normal;-webkit-font-smoothing:antialiased}.ag *{box-sizing:border-box}.ag img{display:block;max-width:100%;height:auto}.ag a{color:inherit}.ag :focus-visible{outline:3px solid var(--blue-hi);outline-offset:3px;border-radius:4px}.ag-bar{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px clamp(16px,4vw,48px);background:rgba(4,6,12,.86);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}.ag-brand{display:flex;align-items:center;gap:12px;text-decoration:none}.ag-brand img{width:44px;height:44px}.ag-brand span{font-family:var(--display);font-size:15px;letter-spacing:.06em;color:var(--silver)}.ag-hero{position:relative;min-height:min(88vh,860px);display:flex;align-items:flex-end;overflow:hidden;isolation:isolate;background:radial-gradient(900px circle at 70% 30%,#12305f 0%,#09101f 55%,#04060c 100%)}.ag-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 60%;z-index:-3}.ag-hero::before{content:'';position:absolute;inset:0;z-index:-2;background:linear-gradient(180deg,rgba(4,6,12,.55) 0%,rgba(4,6,12,.15) 38%,rgba(4,6,12,.88) 82%,#04060c 100%),linear-gradient(90deg,rgba(4,6,12,.82) 0%,rgba(4,6,12,.2) 62%,rgba(4,6,12,0) 100%)}.ag-hero::after{content:'';position:absolute;inset:0;z-index:-1;pointer-events:none;mix-blend-mode:screen;background:radial-gradient(460px circle at var(--mx,74%) var(--my,34%),rgba(56,132,255,.32),transparent 62%)}.ag-hero-copy{width:100%;max-width:1240px;margin:0 auto;padding:0 clamp(20px,5vw,56px) clamp(48px,9vh,96px)}.ag-hero h1{margin:0 0 20px;max-width:15ch;font-family:var(--display);font-weight:400;font-size:clamp(30px,5.4vw,66px);line-height:1.12;letter-spacing:.01em;background:linear-gradient(180deg,#fff 0%,#b9c3d4 55%,#e9edf4 100%);-webkit-background-clip:text;background-clip:text;color:transparent}.ag-hero p{margin:0 0 32px;max-width:46ch;font-size:clamp(17px,1.6vw,20px);color:var(--silver)}.ag .ag-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:10px;background:var(--blue);color:#fff;font-weight:600;font-size:16px;text-decoration:none;border:1px solid #4a86ff;transition:box-shadow .2s,background .2s}.ag .ag-btn:hover{background:#2a6cff;box-shadow:0 0 24px 2px rgba(77,163,255,.45)}.ag .ag-btn.ag-ghost{background:transparent;border-color:var(--line);color:var(--silver)}.ag .ag-btn.ag-ghost:hover{border-color:var(--blue-hi);box-shadow:none;background:rgba(29,95,240,.12)}.ag .ag-btn.ag-soldout{background:transparent;border-color:var(--line);color:var(--dim)}.ag-wrap{max-width:1240px;margin:0 auto;padding:0 clamp(20px,5vw,56px)}.ag-shop{padding:clamp(56px,9vw,112px) 0 clamp(56px,8vw,96px)}.ag-shop-head{margin-bottom:clamp(28px,4vw,48px)}.ag h2{margin:0 0 10px;font-family:var(--display);font-weight:400;font-size:clamp(22px,3vw,34px);color:#fff;letter-spacing:.01em;text-transform:none}.ag-shop-head p{margin:0;color:var(--dim);max-width:52ch}.ag-feature{display:grid;grid-template-columns:1.15fr 1fr;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:var(--panel);margin-bottom:24px}.ag-plinth{display:block;background:linear-gradient(160deg,var(--pa),var(--pb));aspect-ratio:1/1}.ag-plinth img{width:100%;height:100%;object-fit:contain;padding:6%}.ag-info{display:flex;flex-direction:column;justify-content:center;gap:16px;padding:clamp(24px,4vw,56px)}.ag-feature h3{margin:0;font-family:var(--display);font-weight:400;font-size:clamp(20px,2.4vw,30px);line-height:1.25;color:#fff}.ag-desc{margin:0;color:var(--silver);max-width:44ch}.ag-price{font-size:22px;font-weight:600;color:#fff}.ag-price small{font-size:13px;font-weight:500;color:var(--dim);margin-left:4px}.ag-finish{border:0;margin:0;padding:0}.ag-finish legend{padding:0;margin-bottom:8px;color:var(--dim);font-size:15px}.ag-opts{display:flex;gap:10px;flex-wrap:wrap}.ag-opts span{position:relative}.ag-opts input{position:absolute;opacity:0;width:1px;height:1px}.ag-opts label{display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border:1px solid var(--line);border-radius:10px;cursor:pointer;color:var(--silver);font-weight:500}.ag-opts input:checked+label{border-color:var(--blue-hi);background:rgba(29,95,240,.2);color:#fff}.ag-opts input:focus-visible+label{outline:3px solid var(--blue-hi);outline-offset:3px}.ag-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:8px}.ag-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}.ag-card{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--panel)}.ag-body{display:flex;flex-direction:column;gap:10px;padding:20px;flex:1}.ag-card h3{margin:0;font-size:18px;font-weight:600;line-height:1.3;color:#fff}.ag-card p{margin:0;font-size:15px;color:var(--dim);flex:1}.ag-foot{display:flex;flex-direction:column;gap:14px;margin-top:6px}.ag-foot .ag-btn{width:100%;min-height:46px}.ag-more{display:flex;justify-content:center;margin-top:36px}.ag-policies{padding:0 0 clamp(64px,10vw,120px)}.ag-policy-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:clamp(20px,3vw,32px)}.ag-policy{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:clamp(22px,3vw,36px)}.ag-policy h3{margin:0 0 12px;font-size:20px;font-weight:600;color:#fff}.ag-policy p{margin:0 0 12px;color:var(--silver);max-width:52ch}.ag-policy p:last-child{margin-bottom:0}.ag-policy a{color:var(--blue-hi)}.ag-footer{border-top:1px solid var(--line);background:#09101f}.ag-foot-in{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;padding-top:36px;padding-bottom:36px}.ag-foot-in .ag-brand img{width:56px;height:56px}.ag-foot-in p{margin:0;color:var(--dim);font-size:15px}.ag-foot-links{display:flex;gap:8px}.ag-foot-links a{display:inline-flex;align-items:center;min-height:44px;padding:0 12px;color:var(--silver);text-decoration:none}.ag-foot-links a:hover{color:#fff}@media (max-width:1100px){.ag-grid{grid-template-columns:repeat(2,1fr)}}@media (max-width:820px){.ag-feature,.ag-policy-grid{grid-template-columns:1fr}.ag-brand span{font-size:13px}}@media (max-width:520px){.ag-grid{grid-template-columns:1fr}.ag-hero{min-height:82vh}.ag-actions .ag-btn{width:100%}}@media (prefers-reduced-motion:reduce){.ag .ag-btn{transition:none}}</style><div class='ag' id='ag-top'><header class='ag-bar'><a class='ag-brand' href='#ag-top' aria-label='Agent Gadget home'>{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 160 | image_tag: width: 44, height: 44, alt: 'Agent Gadget logo' }}{% endif %}<span>AGENT GADGET</span></a></header><main><section class='ag-hero' id='ag-hero' aria-labelledby='ag-hero-title'>{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2000 | image_tag: class: 'ag-hero-img', loading: 'eager', alt: 'A dark desk lit in blue with headphones, a laptop, a smartwatch, earbuds and a power bank in front of a night city skyline' }}{% endif %}<div class='ag-hero-copy'><h1 id='ag-hero-title'>{{ section.settings.headline }}</h1><p>{{ section.settings.subhead }}</p><a class='ag-btn' href='#ag-shop'>Shop the collection</a></div></section><section class='ag-shop' id='ag-shop' aria-labelledby='ag-shop-title'><div class='ag-wrap'><div class='ag-shop-head'><h2 id='ag-shop-title'>The collection</h2><p>Audio, wearable and power gear. Checkout is handled securely by Shopify.</p></div>{%- assign feature = section.settings.featured_product -%}{%- if feature == blank -%}{%- assign feature = all_products['ten-in-one-smart-watch-set-with-wireless-earbuds-multiple-watch-bands-magnetic-charger-protective-case-all-in-one-fitness-smartwatch-gift-box-for-men-women'] -%}{%- endif -%}{%- if feature != blank -%}<article class='ag-feature'><a class='ag-plinth' href='{{ feature.url }}' aria-label='View {{ feature.title | escape }}'>{{ feature.featured_image | image_url: width: 900 | image_tag: alt: feature.title, loading: 'lazy' }}</a><div class='ag-info'><h3>{{ feature.title }}</h3><p class='ag-desc'>{% render 'ag-blurb', handle: feature.handle %}</p>{%- unless feature.has_only_default_variant -%}<fieldset class='ag-finish'><legend>{{ feature.options[0] }}</legend><div class='ag-opts'>{%- for v in feature.variants -%}<span><input type='radio' name='ag-finish' id='ag-v-{{ v.id }}' value='{{ v.id }}'{% if forloop.first %} checked{% endif %}><label for='ag-v-{{ v.id }}'>{{ v.title }}</label></span>{%- endfor -%}</div></fieldset>{%- endunless -%}<div class='ag-actions'><span class='ag-price'>{{ feature.price | money }}<small>{{ cart.currency.iso_code }}</small></span>{%- if feature.available -%}<a class='ag-btn' id='ag-feature-buy' data-cart='{{ routes.cart_url }}' href='{{ routes.cart_url }}/{{ feature.first_available_variant.id }}:1'>Buy now</a>{%- else -%}<span class='ag-btn ag-soldout'>Sold out</span>{%- endif -%}</div></div></article>{%- endif -%}{%- assign grid = section.settings.collection -%}{%- if grid == blank -%}{%- assign grid = collections['featured'] -%}{%- endif -%}{%- if grid == blank -%}{%- assign grid = collections.all -%}{%- endif -%}<div class='ag-grid'>{%- for product in grid.products limit: 24 -%}{%- if product.id != feature.id -%}<article class='ag-card'><a class='ag-plinth' href='{{ product.url }}' aria-label='View {{ product.title | escape }}'>{{ product.featured_image | image_url: width: 700 | image_tag: alt: product.title, loading: 'lazy' }}</a><div class='ag-body'><h3>{{ product.title }}</h3><p>{% render 'ag-blurb', handle: product.handle %}</p><div class='ag-foot'><span class='ag-price'>{% if product.price_varies %}From {% endif %}{{ product.price | money }}<small>{{ cart.currency.iso_code }}</small></span>{%- if product.available == false -%}<span class='ag-btn ag-soldout'>Sold out</span>{%- elsif product.variants.size == 1 -%}<a class='ag-btn' href='{{ routes.cart_url }}/{{ product.variants.first.id }}:1'>Buy now</a>{%- else -%}<a class='ag-btn ag-ghost' href='{{ product.url }}'>Choose options</a>{%- endif -%}</div></div></article>{%- endif -%}{%- endfor -%}</div><div class='ag-more'><a class='ag-btn ag-ghost' href='{{ routes.all_products_collection_url }}'>Shop all products</a></div></div></section><section class='ag-policies' id='ag-policies' aria-labelledby='ag-policies-title'><div class='ag-wrap'><h2 id='ag-policies-title'>Shipping and returns</h2><div class='ag-policy-grid'><div class='ag-policy'><h3>Shipping</h3><p>We process every order in 2 to 3 days.</p><p>Once your order has been processed, shipping takes up to a week.</p></div><div class='ag-policy'><h3>Returns</h3><p>You can return an item within 7 days of the day it is delivered.</p><p>Please <a href='mailto:{{ shop.email }}?subject=Return%20request'>contact us first</a>, before you send anything back.</p></div></div></div></section></main><footer class='ag-footer'><div class='ag-wrap ag-foot-in'><a class='ag-brand' href='#ag-top' aria-label='Back to top'>{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 160 | image_tag: width: 56, height: 56, alt: 'Agent Gadget logo' }}{% endif %}<span>AGENT GADGET</span></a><p>Checkout is handled securely by Shopify.</p><nav class='ag-foot-links' aria-label='Footer'><a href='#ag-shop'>Shop</a><a href='#ag-policies'>Shipping and returns</a><a href='{{ routes.cart_url }}'>Cart</a></nav></div></footer></div><script>(function(){var buy=document.getElementById('ag-feature-buy');if(buy){document.querySelectorAll('input[name=ag-finish]').forEach(function(r){r.addEventListener('change',function(){if(r.checked){buy.href=buy.getAttribute('data-cart')+'/'+r.value+':1';}});});}var hero=document.getElementById('ag-hero');var calm=window.matchMedia('(prefers-reduced-motion: reduce)').matches;if(hero&&!calm){var raf=null,x=0,y=0;hero.addEventListener('pointermove',function(e){if(e.pointerType==='touch')return;var b=hero.getBoundingClientRect();x=e.clientX-b.left;y=e.clientY-b.top;if(raf)return;raf=requestAnimationFrame(function(){hero.style.setProperty('--mx',x+'px');hero.style.setProperty('--my',y+'px');raf=null;});});}})();</script>{% schema %}{"name":"Agent Gadget home","settings":[{"type":"image_picker","id":"logo","label":"Logo (AG badge)"},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"text","id":"headline","label":"Headline","default":"Serious gadgets, quietly luxurious."},{"type":"textarea","id":"subhead","label":"Subheading","default":"Wireless audio, wearables and portable power, picked for people who want their tech to look as good as it works."},{"type":"product","id":"featured_product","label":"Featured product"},{"type":"collection","id":"collection","label":"Products shown in the grid (defaults to the Featured collection)"}],"presets":[{"name":"Agent Gadget home"}]}{% endschema %}